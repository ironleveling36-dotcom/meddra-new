# Server
HOST=0.0.0.0
PORT=8000

# MedDRA Search Engine
ENABLE_SEMANTIC=true
MEDDRA_DATA_DIR=./data
FASTEMBED_CACHE_DIR=./data/.cache     # persist model between restarts
QUERY_CACHE_SIZE=1024
QUERY_CACHE_TTL=3600

# SenseNova AI Configuration
AI_ENABLED=true
AI_API_KEY=sk_your_sensenova_api_key_here
AI_API_BASE_URL=https://api.hcnsec.cn/v1
AI_MODEL=sensenova-6.8-flash-lite
AI_DEFAULT=true

# Response Cache
RESPONSE_CACHE_TTL=300

# Logging
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=*

# Telegram Bot (Optional)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Features
ENABLE_QUERY_CACHE=true
ENABLE_RESPONSE_CACHE=true
ENABLE_PREPROCESSING=true
